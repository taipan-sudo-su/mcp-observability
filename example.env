# API Keys
# Preferred: comma-separated user:key pairs
MCP_API_KEYS=alice:key-abc,bob:key-xyz
# Legacy single key (username becomes "default")
# MCP_API_KEY=somekey

# RBAC — map users to roles (admin or readonly)
# admin   : full access to all tools including grafana_create_annotation
# readonly: read-only tools only (no write operations)
# Omit a user to default to admin.
MCP_ROLES=alice:admin,bob:readonly

# Rate limiting — max MCP requests per minute per user (0 = unlimited)
MCP_RATE_LIMIT=60

# Backend URLs — defaults point to in-cluster service DNS
PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090
LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
TEMPO_URL=http://tempo.monitoring.svc.cluster.local:3200
ALERTMANAGER_URL=http://kube-prometheus-stack-alertmanager.monitoring.svc.cluster.local:9093
GRAFANA_URL=http://grafana.monitoring.svc.cluster.local:3000

# Grafana service account token (required for annotation write access)
GRAFANA_TOKEN=
